# Copy to api/.env. Paths point at pipeline outputs, opened read-only; never copy them into this repo.

# Universe table `briefs`. On the VPS today: /var/lib/alphacouncil/briefs_index.sqlite
# Locally: a snapshot folder, e.g. C:\AlphaCouncil-Staging\snapshots\<snapshot>\briefs_index.sqlite
BRIEFS_DB=
# true for a frozen snapshot copy, false for the live file the pipeline rewrites
MARKET_DB_IMMUTABLE=true

# Company names (from the pipeline repo's argaam/ folder)
TICKER_NAMES_CSV=
SAUDI_EN_NAMES_CSV=

# Used from Phase 4/5 (accounts, preferences, live prices)
DATABASE_URL=
REDIS_URL=
