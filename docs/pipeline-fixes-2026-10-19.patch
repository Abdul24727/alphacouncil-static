From ee88d04eadf5370516671592066c1101544b8f2c Mon Sep 17 00:00:00 2001
From: "Claude (audit part 2)" <claude@local>
Date: Mon, 19 Oct 2026 14:26:57 +0300
Subject: [PATCH 3/4] F-B: ADX/DFM prices take the chart endpoint's full
 precision; _fmt_price keeps up to 4 decimals

---
 argaam/main_patched2026_with_sectors.py | 60 ++++++++++++++++++++++++-
 1 file changed, 59 insertions(+), 1 deletion(-)

diff --git a/argaam/main_patched2026_with_sectors.py b/argaam/main_patched2026_with_sectors.py
index 17066bf..5b99370 100644
--- a/argaam/main_patched2026_with_sectors.py
+++ b/argaam/main_patched2026_with_sectors.py
@@ -2582,9 +2582,64 @@ def _scrape_chart_tradingview(page, chart_url: str, run_dir: Path, ticker: str,
 
 
 def _fmt_price(val) -> str:
+    """Up to 4 decimals, at least 2: sub-1 prices tick in 0.001 (audit part 2, F-B)."""
     if val is None:
         return ""
-    return f"{float(val):.2f}"
+    s = f"{float(val):.4f}".rstrip("0")
+    return s if len(s.split(".")[1]) >= 2 else f"{float(val):.2f}"
+
+def _price_cell_float(cell) -> Optional[float]:
+    try:
+        return float(str(cell).replace(",", "").strip())
+    except (TypeError, ValueError):
+        return None
+
+def _tv_price_overlay(html: str, headers: List[str], rows: List[List[str]],
+                      ticker: str) -> Tuple[List[List[str]], int]:
+    """Put the chart endpoint's full-precision Price/Open/High/Low into the rows of Argaam's
+    2-decimal HTML price table (audit part 2, F-B). A row changes only when the endpoint has a
+    bar with the same date and volume whose close rounds to the table's close; any other row,
+    and any fetch failure, keeps the table's values. Returns (rows, number of rows changed)."""
+    import urllib.request
+    import urllib.parse
+    cid = re.search(r'var\s+companyID\s*=\s*(\d+)', html or "")
+    if not cid or len(headers) != 9:
+        return rows, 0
+    entity_id = f"C_{cid.group(1).zfill(4)}"
+    api_url = (f"{BASE_URL}/en/charts/history"
+               f"?symbol={urllib.parse.quote(entity_id)}&resolution=1D&from=1462060800")
+    try:
+        req = urllib.request.Request(api_url, headers={"User-Agent": "Mozilla/5.0", "Accept": "application/json"})
+        with urllib.request.urlopen(req, timeout=30) as response:
+            data = json.loads(response.read().decode("utf-8"))
+    except Exception as e:
+        print(f"[WARN] price overlay skipped for {ticker}: {e}")
+        return rows, 0
+    if data.get("s") != "ok":
+        return rows, 0
+    bars = {}
+    for i, t in enumerate(data.get("t") or []):
+        try:
+            bars[datetime.fromtimestamp(t, tz=timezone.utc).date()] = (
+                data["c"][i], data["o"][i], data["h"][i], data["l"][i], data["v"][i])
+        except (IndexError, KeyError, TypeError, ValueError, OSError):
+            continue
+    out, changed = [], 0
+    for row in rows:
+        dt = parse_date_any(row[0]) if row else None
+        bar = bars.get(dt.date()) if dt else None
+        close = _price_cell_float(row[1]) if len(row) >= 9 else None
+        vol = _price_cell_float(row[4]) if len(row) >= 9 else None
+        if (bar is None or close is None or vol is None or None in bar
+                or int(float(bar[4])) != int(vol) or abs(float(bar[0]) - close) > 0.0051):
+            out.append(row)
+            continue
+        new = list(row)
+        new[1], new[6], new[7], new[8] = (_fmt_price(bar[0]), _fmt_price(bar[1]),
+                                          _fmt_price(bar[2]), _fmt_price(bar[3]))
+        changed += new != row
+        out.append(new)
+    return out, changed
 
 def _fmt_turnover(a_arr, i) -> str:
     try:
@@ -2821,6 +2876,9 @@ def _scrape_chart_ajax_form(page, chart_url: str, run_dir: Path, ticker: str,
     if len(rows) < 5:
         print(f"[WARN] Only {len(rows)} rows extracted — data may be incomplete")
 
+    rows, n_precise = _tv_price_overlay(html, headers, rows, ticker)
+    meta["counts"]["rows_full_precision"] = n_precise
+
     required_csv = run_dir / "price_history_10y.csv"
     write_price_csv(required_csv, headers, rows)
     meta["counts"]["rows"] = len(rows)
-- 
