new file mode 100644
index 0000000..9ebf0f4
--- /dev/null
+++ b/argaam/tools/chart_failures.py
@@ -0,0 +1,57 @@
+"""List tickers whose price chart did not come through (audit part 2, F-A).
+
+A ticker counts as done after any attempt that did not crash, so the nightly
+"done 716/716" hides tickers whose chart page failed (for example a company page
+Argaam renamed, which answers 404). This prints one line for the nightly alert:
+
+    no fresh price chart: 3 (2080_TADAWUL, 624_KSE, TAQA_ADX)
+
+A ticker is listed when its newest run's chart section failed, or when its
+price_history_10y.csv is missing or older than --max-age-days. Read-only; exit 0.
+
+    python tools/chart_failures.py default_universe [--max-age-days 7]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+
+# Same ticker-folder pattern as select_latest_complete.py.
+TICKER_DIR_RE = re.compile(r"^[A-Za-z0-9\. ]+_(TADAWUL|ADX|DFM|KSE|QSE|MSM|BSE)$")
+
+
+def chart_failures(universe: Path, max_age_days: int) -> list[str]:
+    now = datetime.now(timezone.utc)
+    bad = []
+    for d in sorted(p for p in universe.iterdir() if p.is_dir() and TICKER_DIR_RE.match(p.name)):
+        runs = sorted((d / "harvest_runs").glob("run_*"))
+        if not runs:
+            continue
+        try:
+            meta = json.loads((runs[-1] / "meta.json").read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            continue
+        chart = (meta.get("sections") or {}).get("chart")
+        price = d / "price_history_10y.csv"
+        age = ((now - datetime.fromtimestamp(price.stat().st_mtime, timezone.utc)).days
+               if price.exists() else None)
+        if (chart is not None and not chart.get("ok")) or age is None or age > max_age_days:
+            bad.append(d.name)
+    return bad
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("universe", type=Path)
+    ap.add_argument("--max-age-days", type=int, default=7)
+    args = ap.parse_args()
+    bad = chart_failures(args.universe, args.max_age_days)
+    print(f"no fresh price chart: {len(bad)}" + (f" ({', '.join(bad)})" if bad else ""))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
