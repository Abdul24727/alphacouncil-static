From 047fb908e861dbf6e2fcda5d66e9586684594028 Mon Sep 17 00:00:00 2001
From: "Claude (audit part 2)" <claude@local>
Date: Mon, 19 Oct 2026 14:26:57 +0300
Subject: [PATCH 4/4] F-C: drop bars the source carries forward over market
 holidays

---
 argaam/main_patched2026_with_sectors.py | 29 +++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/argaam/main_patched2026_with_sectors.py b/argaam/main_patched2026_with_sectors.py
index 5b99370..bbe1fb7 100644
--- a/argaam/main_patched2026_with_sectors.py
+++ b/argaam/main_patched2026_with_sectors.py
@@ -6606,8 +6606,37 @@ def validate_price_range(headers: List[str], rows: List[List[str]], expected_yea
         return True, diag
     diag["error"] = f"insufficient_range (got {years_covered:.1f}y, need {expected_years}y)"
     return False, diag
+def _drop_carried_forward_bars(rows: List[List[str]]) -> Tuple[List[List[str]], int]:
+    """Drop a bar that repeats the previous bar in Price, Volume, Turnover, Open, High and Low
+    with Volume above 0: the sources carry the last session forward on market holidays (audit
+    part 2, F-C). The first bar is kept. Rows may be oldest- or newest-first."""
+    if len(rows) < 2:
+        return rows, 0
+    d0 = parse_date_any(rows[0][0]) if rows[0] else None
+    d1 = parse_date_any(rows[-1][0]) if rows[-1] else None
+    newest_first = bool(d0 and d1 and d0 > d1)
+    kept, prev = [], None
+    for row in (reversed(rows) if newest_first else rows):
+        key = tuple(row[i].strip() for i in (1, 4, 5, 6, 7, 8)) if len(row) >= 9 else None
+        try:
+            traded = float(row[4].replace(",", "").strip()) > 0
+        except (IndexError, ValueError):
+            traded = False
+        if key is not None and key == prev and traded:
+            continue
+        kept.append(row)
+        prev = key
+    if newest_first:
+        kept.reverse()
+    return kept, len(rows) - len(kept)
+
+
 def write_price_csv(csv_path: Path, headers: List[str], rows: List[List[str]]) -> None:
