 # figure); Balance Sheet is a STOCK measure (take the year-end snapshot).
 _FLOW_SECTIONS = {"Income Statement", "Cash Flow Statement"}
 
+# REPAIR (aggregation). A row inside a FLOW section that is a share COUNT is not a flow: summing
+# four quarters of "Shares Outstanding (Million)" reported 4x the real count (Aramco 968,000
+# against 242,000; SABIC 12,000 against 3,000, both contradicting their own balance sheets). These
+# take the window's END quarter instead. Per-share EARNINGS are genuinely per-period and are still
+# summed, which is what makes four quarterly EPS figures add to the annual one. Both Arabic
+# spellings of "number of shares" occur in the GCC grids, with and without the hamza.
+# A POSITION: true at an instant, so a window takes its END quarter. Summing four quarters of
+# these is what reported 4x the real share count.
+_POSITION_MARKERS = ("shares outstanding", "par value")
+# A PERIOD AVERAGE: already an average over its own quarter, so a four-quarter window takes the
+# MEAN, not the end quarter. This is the denominator earnings per share is actually struck on, and
+# it only differs from the position when the share count moved - which is exactly when it matters.
+# Both Arabic spellings of "number of shares" occur in the GCC grids, with and without the hamza.
+_AVERAGE_MARKERS = (
+    "average number of shares", "weighted average",
+    "\u0645\u062a\u0648\u0633\u0637 \u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0647\u0645",
+    "\u0645\u062a\u0648\u0633\u0637 \u0639\u062f\u062f \u0627\u0644\u0627\u0633\u0647\u0645",
+)
+_COUNT_MARKERS = _POSITION_MARKERS + _AVERAGE_MARKERS
+_QUARTER_MONTHS = (3, 6, 9, 12)
+
+
+def aggregation_of(label: str) -> str:
+    """How a row inside a FLOW section combines across a window: "sum", "end" or "mean".
+
+    Checked in this order on purpose. "Average number of shares (Million)" contains "number of
+    shares", so an average row must be recognised BEFORE the position markers or it would be
+    treated as a position and take the end quarter.
+    """
+    low = (label or "").lower()
+    if any(m in low for m in _AVERAGE_MARKERS):
+        return "mean"
+    if any(m in low for m in _POSITION_MARKERS):
+        return "end"
+    return "sum"
+
+
+def is_count_row(label: str) -> bool:
+    """Kept for callers that only need to know a row is not summed."""
+    return aggregation_of(label) != "sum"
+
+
+def month_label(year: int, month: int) -> str:
+    return f"{year}-{month:02d}"
+
+
+def quarter_windows(keys) -> list:
+    """Every run of four CONSECUTIVE populated quarters, oldest window first.
+
+    `keys` are the (year, month) pairs this row actually has a value for, so a row with a gap -
+    or with only part of the newest quarter published - yields no window rather than a wrong sum.
+    """
+    order = sorted(keys)
+    windows = []
+    for i in range(len(order) - 3):
+        run = order[i:i + 4]
+        ok = True
+        for a, b in zip(run, run[1:]):
+            step = (b[0] - a[0]) * 12 + (b[1] - a[1])
+            if step != 3:
+                ok = False
+                break
+        if ok:
+            windows.append(run)
+    return windows
+
+
+def window_period(run) -> tuple:
+    """(period, fiscal_year, period_end) for a four-quarter window: FY when it is exactly one
+    fiscal year, TTM otherwise. A TTM figure must never be labelled a fiscal year - that is the
+    difference between "the business earned this in 2025" and "this is the last twelve months"."""
+    years = {y for y, _m in run}
+    months = {m for _y, m in run}
+    end_y, end_m = run[-1]
+    if len(years) == 1 and months == set(_QUARTER_MONTHS):
+        return "FY", end_y, month_label(end_y, 12)
+    return "TTM", end_y, month_label(end_y, end_m)
+
 
