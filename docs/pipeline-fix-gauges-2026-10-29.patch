+def _vintage(conn, tk: str, year: int) -> dict:
+    """PROVENANCE. Which reporting window the inputs of this fiscal year come from.
+
+    The parser records `period` (FY | TTM | Q) and `period_end` per row, and a repaired Tadawul
+    year carries a flow window (TTM to a quarter end) beside a balance sheet struck at that same
+    quarter end. Both dates belong on the gauge: a ratio of a flow over a position is only as
+    comparable as the two dates behind it. Databases parsed before the repair have no such
+    columns, and then the vintage is simply the fiscal year."""
+    cols = {r[1] for r in conn.execute("PRAGMA table_info(fundamentals_lineitems)")}
+    if not {"period", "period_end"} <= cols:
+        return {"fiscal_year": year}
+    rows = conn.execute(
+        "SELECT section, period, period_end, count(*) n FROM fundamentals_lineitems"
+        " WHERE ticker_key=? AND fiscal_year=? GROUP BY 1,2,3 ORDER BY n DESC", (tk, year)).fetchall()
+    flow = next((r for r in rows if r[0] in ("Income Statement", "Cash Flow Statement")), None)
+    position = next((r for r in rows if r[0] == "Balance Sheet"), None)
+    return {"fiscal_year": year,
+            "period": flow[1] if flow else (position[1] if position else None),
+            "period_end": flow[2] if flow else (position[2] if position else None),
+            "position_at": position[2] if position else None}
+
