  "_in_statement_about": "A label that means something else inside one statement. Banks' income-statement sub-lines repeat a balance-sheet line's words under \"Special commission income/expense\" (Argaam row ids tr23-tr28); every income statement on the Saudi English and Gulf Arabic pages (39, 2026-11-06) uses these texts only there, so inside an income statement they are shown with the meaning their parent gives them, in both languages. `match` lists the stored texts (either language); outside the statement the pairs above apply.",
  "in_statement": {
    "Income Statement": [
      {"match": ["الاستثمارات", "Investments"], "en": "Special commission income from investments", "ar": "دخل العمولات الخاصة من الاستثمارات"},
      {"match": ["أرصدة لدى البنوك والمؤسسات المالية", "Due from Banks & Other FI's"], "en": "Special commission income from banks & other FIs", "ar": "دخل العمولات الخاصة من الأرصدة لدى البنوك والمؤسسات المالية"},
      {"match": ["قروض و سلف", "Loans and Advances"], "en": "Special commission income from loans and advances", "ar": "دخل العمولات الخاصة من القروض والسلف"},
      {"match": ["ارصدة للبنوك و المؤسسات المالية", "Due to Banks"], "en": "Special commission expense on due to banks & other FIs", "ar": "مصاريف العمولات الخاصة على الأرصدة للبنوك والمؤسسات المالية"},
      {"match": ["ودائع العملاء", "Customer Deposits"], "en": "Special commission expense on customer deposits", "ar": "مصاريف العمولات الخاصة على ودائع العملاء"}
    ]
  }
