# /etc/alphacouncil-platform/api.env on the VPS (root:alphacouncil 0640).
# Live pipeline outputs, read-only. The files are WAL databases that the
# pipeline publishes by atomic replacement, so each request opens them with
# immutable=1: no -shm/-wal files are ever created in /var/lib/alphacouncil.
BRIEFS_DB=/var/lib/alphacouncil/briefs_index.sqlite
SCREENING_DB=/var/lib/alphacouncil/screening.sqlite
EVIDENCE_DB=/var/lib/alphacouncil/evidence.sqlite
MARKET_DB_IMMUTABLE=true
UNIVERSE_ROOT=/opt/alphacouncil/backend/argaam/default_universe
TICKER_NAMES_CSV=/opt/alphacouncil/backend/argaam/tickers_universe_corrected.csv
SAUDI_EN_NAMES_CSV=/opt/alphacouncil/backend/argaam/tickers_saudi_en_names.csv
