# /etc/alphacouncil-platform/api.env on the VPS (root:alphacouncil 0640).
# Live pipeline outputs, read-only. The files are WAL databases that the
# pipeline publishes by atomic replacement, so each request opens them with
# immutable=1: no -shm/-wal files are ever created in /var/lib/alphacouncil.
BRIEFS_DB=/var/lib/alphacouncil/briefs_index.sqlite
SCREENING_DB=/var/lib/alphacouncil/screening.sqlite
EVIDENCE_DB=/var/lib/alphacouncil/evidence.sqlite
MARKET_INDICES_DB=/var/lib/alphacouncil/market_indices.sqlite
MARKET_DB_IMMUTABLE=true
UNIVERSE_ROOT=/opt/alphacouncil/backend/argaam/default_universe
TICKER_NAMES_CSV=/opt/alphacouncil/backend/argaam/tickers_universe_corrected.csv
SAUDI_EN_NAMES_CSV=/opt/alphacouncil/backend/argaam/tickers_saudi_en_names.csv

# Copilot (all optional; without a key a labelled rule-based stand-in answers).
# COPILOT_PROVIDER=auto            # auto | openrouter | anthropic | standin
# COPILOT_MODEL=deepseek/deepseek-v3.2
# OPENROUTER_API_KEY=              # set on the server only, never committed
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# COPILOT_REASONING=false         # true shows the model's reasoning; slower
# COPILOT_PROVIDER_SORT=latency   # OpenRouter host order: latency | throughput | price | "" (default pick)

# Sign in with Google (app/oauth.py): the old site's Google web client; Google returns to
# <site>/auth/google/callback (nginx passes it to the API).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=            # server only, never committed

# Pro billing (app/billing.py). BILLING_OPEN=true opens the checkout AND ends early access
# (the Free plan's limits apply). Test keys (pk_test_/sk_test_) on beta, live keys in production.
# BILLING_OPEN=false
# MOYASAR_PUBLISHABLE_KEY=
# MOYASAR_SECRET_KEY=              # server only, never committed
# MOYASAR_WEBHOOK_SECRET=          # the shared secret of the dashboard webhook (/api/billing/webhook/moyasar)
# ANTHROPIC_API_KEY=

# Email for "Forgot password?" (optional; without SMTP_HOST the API answers the same and logs
# that email is not configured). The old site's backend used the same variables with MailerSend.
# SMTP_HOST=smtp.mailersend.net
# SMTP_PORT=587                    # 587 = STARTTLS, 465 = TLS
# SMTP_USER=
# SMTP_PASS=                       # set on the server only, never committed
# SMTP_FROM=AlphaCouncil <no-reply@alphacouncil.tech>
# SITE_URL=                        # links in emails; default: the first ALLOWED_ORIGINS entry
