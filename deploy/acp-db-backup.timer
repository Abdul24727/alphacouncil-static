[Unit]
Description=Nightly AlphaCouncil database backup

[Timer]
# 01:30 UTC = 04:30 in Riyadh, the quietest hour; the old site's pipeline starts at 00:00.
OnCalendar=*-*-* 01:30:00 UTC
RandomizedDelaySec=300
# A run missed while the server was down runs at boot.
Persistent=true

[Install]
WantedBy=timers.target
